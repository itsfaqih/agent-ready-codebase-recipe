---
import Base from "../layouts/Base.astro";
import CopyButton from "../components/CopyButton.astro";
import RunDemo from "../components/RunDemo.astro";
import Problems from "../components/Problems.astro";
import RunSteps from "../components/RunSteps.astro";
import DocsFigure from "../components/DocsFigure.astro";
import StatusSprite from "../components/StatusSprite.astro";
import ThemeSwitch from "../components/ThemeSwitch.astro";
import { AREAS, HERO_LEDE, HERO_TITLE, INSTALL_COMMAND, PHASES, REPO_URL, SKILL_COMMAND } from "../data/content";
import * as css from "../styles/page.css";
---

<Base
  title="agent-ready-codebase-recipe"
  description={HERO_LEDE}
>
  <StatusSprite />
  <div class={css.frame}>
    <nav class={css.nav}>
      <span class={css.brand}>agent-ready-codebase-recipe</span>
      <div class={css.navLinks}>
        <a class={css.navLink} href="#run">
          How it runs
        </a>
        <a class={css.navLink} href="#docs">
          Docs it writes
        </a>
        <a class={css.navLink} href={REPO_URL}>
          GitHub
        </a>
        <ThemeSwitch />
      </div>
    </nav>

    <header class={css.hero} data-reveal-group>
      <div class={css.heroText}>
        <div class={css.eyebrow} data-reveal>Agent skill</div>
        <h1 class={css.h1} data-reveal>{HERO_TITLE}</h1>
        <p class={css.lede} data-reveal>{HERO_LEDE}</p>
        <div data-reveal><CopyButton text={SKILL_COMMAND} /></div>
        <p class={css.install} data-install-line data-reveal>
          <span class={css.installText} data-install-text>
            <span class={css.installLabel}>Install first: </span><code class={css.installCode}>{INSTALL_COMMAND}</code>
          </span>
          <CopyButton text={INSTALL_COMMAND} iconLabel="Copy install command" />
        </p>
      </div>
      <div class={css.heroDemo} data-reveal="fade">
        <RunDemo />
        <div class={css.visuallyHidden}>
          <ol aria-label="Run phase">
            {PHASES.map((phase) => <li>{phase.label}</li>)}
          </ol>
          <ul aria-label="The 12 areas the skill checks">
            {AREAS.map((area) => <li>{area.name}: {area.summary}</li>)}
          </ul>
        </div>
      </div>
    </header>

    <section class={css.section} id="problem">
      <div data-reveal-group>
        <div class={css.eyebrow} data-reveal>The problem</div>
        <h2 class={css.h2} data-reveal>Why you still check your agent's work yourself</h2>
        <p class={css.sub} data-reveal>
          Six gaps that leave the checking to you. Each row shows the same screen before the skill runs and after it.
        </p>
      </div>
      <Problems />
    </section>

    <section class={css.section} id="run" data-reveal-group>
      <div class={css.eyebrow} data-reveal>How a run works</div>
      <h2 class={css.h2} data-reveal>It checks what you have before it adds anything</h2>
      <p class={css.sub} data-reveal>
        First it learns what the project is, who uses it and what a broken release costs. Then you confirm how deep each
        area goes.
      </p>
      <RunSteps />
    </section>

    <section class={css.section} id="docs" data-reveal-group>
      <div class={css.eyebrow} data-reveal>What the agent reads afterwards</div>
      <h2 class={css.h2} data-reveal>Your agent reads a doc only when the task needs it</h2>
      <p class={css.sub} data-reveal>
        AGENTS.md has one line per doc that says when to read it. A project gets only the docs it needs.
      </p>
      <DocsFigure />
    </section>

    <div class={css.end} data-reveal-group>
      <h2 class={css.endTitle} data-reveal>Get your repo ready for agents in one run.</h2>
      <p class={css.endSub} data-reveal>
        Spend your review on the decisions. Your agent formats, lints, tests and tries the change in the app before it asks
        you to look.
      </p>
      <div data-reveal><CopyButton text={INSTALL_COMMAND} /></div>
    </div>
    <footer class={css.footer}>
      <span>Made with ❤️ by <a class={css.footerLink} href="https://itsfaqih.dev">Faqih</a></span>
      <a class={css.footerLink} href={REPO_URL}>github.com/itsfaqih</a>
    </footer>
  </div>
</Base>

<script>
  import { markCurrentSection, revealSections } from "../components/sections";

  revealSections(document);

  markCurrentSection(document);
</script>
