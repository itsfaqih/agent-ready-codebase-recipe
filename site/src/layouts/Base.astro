---
import { AREAS, HERO_TITLE, SKILL_COMMAND } from "../data/content";
import { runTimeline } from "../data/run";
import "../styles/global.css";
import { dark, light } from "../styles/palette";
import { chromeColor, themeKey } from "../styles/scheme";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;

// Link previews need absolute URLs, so these follow `site` in astro.config.mjs. `vp run og` films the files.
const shareUrl = (path: string) => new URL(path, Astro.site).href;

const filesWritten = runTimeline(AREAS).at(-1)?.filesWritten;

const shareImageAlt = `${HERO_TITLE}. Beside it, a run of ${SKILL_COMMAND} passes ${AREAS.length} of ${AREAS.length} areas and writes ${filesWritten} files.`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content={light.bg} media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content={dark.bg} media="(prefers-color-scheme: dark)" />
    {
      /* The visitor's stored scheme, applied before any stylesheet so the page never paints the other one first. With
      nothing stored, or storage blocked, the page and the two metas above follow the system. */
    }
    <script is:inline define:vars={{ themeKey, chromeColor }}>
      try {
        const theme = localStorage.getItem(themeKey);

        if (theme === "light" || theme === "dark") {
          document.documentElement.dataset.theme = theme;

          for (const meta of document.querySelectorAll('meta[name="theme-color"]')) meta.content = chromeColor[theme];
        }
      } catch {}
    </script>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={shareUrl("/og.png")} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={shareImageAlt} />
    <meta property="og:video" content={shareUrl("/og.mp4")} />
    <meta property="og:video:type" content="video/mp4" />
    <meta property="og:video:width" content="1920" />
    <meta property="og:video:height" content="1080" />
    <meta name="twitter:card" content="summary_large_image" />
    {
      /* The gate in components/sections.ts, run before the first paint so the hero starts hidden instead of flashing.
      If that module never runs, everything is shown on load rather than left hidden. */
    }
    <script is:inline>
      if ("IntersectionObserver" in window && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
        const html = document.documentElement;
        html.dataset.motion = "";
        addEventListener("load", () => html.dataset.motion === "" && delete html.dataset.motion);
      }
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
