---
import { AREAS, PHASES } from "../data/content";
import { finalMessage, type Status } from "../data/run";
import StatusIcon from "./StatusIcon.astro";
import * as css from "./Board.css";

const statuses: readonly Status[] = ["missing", "partial", "done"];

const lastPhase = PHASES.length - 1;
---

<div class={css.board} data-board>
  <ol class={css.tabs} aria-label="Run phase">
    {PHASES.map((phase, i) => (
      <li class={css.tab} data-phase={phase.id} aria-current={i === lastPhase ? "step" : undefined}>
        <span class={css.tabNumber}>{i + 1}</span>
        {phase.label}
      </li>
    ))}
  </ol>
  <ul class={css.grid} aria-label="The 12 areas the skill checks">
    {AREAS.map((area) => (
      <li class={css.tile} data-status="done" data-area={area.name}>
        <span class={css.chip}>
          {statuses.map((s) => (
            <StatusIcon status={s} size={22} class={css.icon[s]} />
          ))}
        </span>
        <span>
          <strong class={css.name}>{area.name}</strong>
          <span class={css.summary}>{area.summary}</span>
        </span>
      </li>
    ))}
  </ul>
  <div class={css.foot}>
    <span class={css.status} data-status-line data-final aria-live="off">
      {finalMessage(AREAS.length)}
    </span>
    <span class={css.legend} aria-hidden="true">
      <span>
        <StatusIcon status="done" size={12} class={css.legendIcon} />
        done
      </span>
      <span>
        <StatusIcon status="partial" size={12} class={css.legendIcon} />
        partial
      </span>
      <span>
        <StatusIcon status="missing" size={12} class={css.legendIcon} />
        missing
      </span>
    </span>
  </div>
</div>

<script>
  import { playBoard } from "./board";

  playBoard(document);
</script>
